# LLM provider: gemini | openai | ollama  (openai also accepts alias "codex")
# Leave unset to auto-detect from available credentials.
PAPERLESS_LLM_PROVIDER=openai

# --- OpenAI / Codex ---
# Preferred: use the web UI "Sign in with ChatGPT" (OAuth).
# Alternative: paste a Platform API key here or via the UI Auth panel.
OPENAI_API_KEY=

# Optional overrides when provider=openai
PAPERLESS_MODEL=gpt-5.6-luna
PAPERLESS_EMBEDDING_MODEL=text-embedding-3-small

# --- Gemini (alternative) ---
# PAPERLESS_LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# PAPERLESS_MODEL=gemini-flash-latest
# PAPERLESS_EMBEDDING_MODEL=text-embedding-004

# --- Ollama (alternative, fully local) ---
# Needs a multimodal model (AI OCR sends page images), e.g. gemma3,
# llama3.2-vision, or qwen2.5vl, plus an embedding model:
#   ollama pull gemma3 && ollama pull nomic-embed-text
# PAPERLESS_LLM_PROVIDER=ollama
# PAPERLESS_MODEL=gemma3
# PAPERLESS_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

DATA_DIR=./data
