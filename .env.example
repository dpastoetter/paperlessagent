# PaperlessAgent — copy to .env and adjust.
# Prefer the web UI for provider setup: Settings → AI provider.

# --- Storage ---
DATA_DIR=./data

# --- Web server (manual uvicorn / systemd autostart) ---
# PAPERLESS_HOST=127.0.0.1
# PAPERLESS_PORT=8080
# PAPERLESS_LOG_LEVEL=warning          # desktop wrapper only
#
# Non-loopback binds (0.0.0.0, LAN IP) require ALL of:
#   PAPERLESS_ALLOW_REMOTE=1
#   PAPERLESS_API_TOKEN=…
#   PAPERLESS_SSL_CERTFILE=… and PAPERLESS_SSL_KEYFILE=… (HTTPS on uvicorn)
# Prefer local mode instead: PAPERLESS_HOST=127.0.0.1 + TLS reverse proxy (see README).
# PAPERLESS_ALLOW_REMOTE=0
# PAPERLESS_API_TOKEN=
# PAPERLESS_SSL_CERTFILE=/path/to/fullchain.pem
# PAPERLESS_SSL_KEYFILE=/path/to/privkey.pem
# Browser sessions (pa_session cookie) last this many seconds (default 86400 = 24h).
# PAPERLESS_SESSION_TTL_SECONDS=86400
# Optional Host allowlist (comma-separated). Defaults include localhost / 127.0.0.1.
# PAPERLESS_ALLOWED_HOSTS=localhost,127.0.0.1,paperless.example.com
# Trust X-Forwarded-For / X-Forwarded-Proto ONLY from these proxy IPs/CIDRs
# (client IP / HTTPS detection — never used to skip authentication).
# Catch-alls such as 0.0.0.0/0 and ::/0 are ignored.
# PAPERLESS_TRUSTED_PROXIES=127.0.0.1,::1

# --- LLM provider ---
# gemini | openai | ollama  (openai also accepts alias "codex")
# Leave unset to auto-detect: OpenAI key → Gemini key → running local Ollama → Gemini.
PAPERLESS_LLM_PROVIDER=openai
# PAPERLESS_SKIP_OLLAMA_PROBE=1        # skip localhost Ollama probe during auto-detect

# --- OpenAI / Codex ---
# Preferred: Settings → Cloud (ChatGPT) → Sign in with ChatGPT (OAuth).
# Alternative: paste a Platform API key in the UI or here.
OPENAI_API_KEY=

PAPERLESS_MODEL=gpt-5.6-luna
PAPERLESS_EMBEDDING_MODEL=text-embedding-3-small
# PAPERLESS_CODEX_MODEL=gpt-5.6-terra  # ChatGPT OAuth model override
# ChatGPT OAuth (no Platform API key) uses local ONNX MiniLM embeddings for RAG;
# Platform embedding APIs require an API key. Switching providers auto-rebuilds the index.
# Ask: drop semantic hits farther than this cosine distance (0 = identical).
# PAPERLESS_ASK_MAX_CHUNK_DISTANCE=0.55

# --- Gemini ---
# PAPERLESS_LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# PAPERLESS_MODEL=gemini-flash-latest
# PAPERLESS_EMBEDDING_MODEL=text-embedding-004

# --- Ollama (fully local by default) ---
# Easiest: Settings → Local Ollama → Pull required models.
# Needs a multimodal chat model (default gemma3) plus nomic-embed-text:
#   ollama pull gemma3 && ollama pull nomic-embed-text
# PAPERLESS_LLM_PROVIDER=ollama
# PAPERLESS_MODEL=gemma3
# PAPERLESS_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# Local mode only allows localhost / 127.0.0.1 / ::1.
# Remote Ollama (LAN / another host) requires an explicit opt-in and the same
# privacy disclaimer as cloud AI (documents leave this machine):
# PAPERLESS_ALLOW_REMOTE_OLLAMA=1
# OLLAMA_BASE_URL=http://192.168.1.10:11434

# --- Untrusted media (PDF/image) ---
# PAPERLESS_MEDIA_MAX_IMAGE_PIXELS=40000000
# PAPERLESS_MEDIA_MAX_PDF_PAGES=128          # also rejects at upload
# PAPERLESS_MEDIA_MAX_PDF_PAGE_POINTS=14400  # MediaBox cap (~200 in)
# PAPERLESS_MEDIA_WORKER=1                   # isolate Poppler/Pillow/pypdf
# PAPERLESS_MEDIA_WORKER_TIMEOUT_S=90
# PAPERLESS_MEDIA_WORKER_MEMORY_MB=4096      # virtual AS cap (Poppler needs headroom)
# PAPERLESS_MEDIA_WORKER_CPU_S=120

# --- LLM timeouts (seconds) ---
# PAPERLESS_LLM_TIMEOUT=120
# PAPERLESS_LLM_VISION_TIMEOUT=300
# PAPERLESS_OLLAMA_TIMEOUT=300
# PAPERLESS_CANCEL_JOIN_TIMEOUT=3      # max wait when joining a cancelled LLM call

# --- OCR / long documents ---
# Adaptive modes: fast | balanced | maximum (Settings → Filing can also set this)
# PAPERLESS_OCR_MODE=balanced
# PAPERLESS_OCR_CONCURRENCY=4          # parallel vision pages (cloud)
# PAPERLESS_OCR_CONCURRENCY_OLLAMA=1   # parallel vision pages (local Ollama)
# Default: process all PDF pages (up to PAPERLESS_OCR_SAFETY_MAX_PAGES).
# PAPERLESS_OCR_MAX_PAGES=0            # 0 = all pages; e.g. 8 on slow hardware
# PAPERLESS_OCR_SAFETY_MAX_PAGES=128
# PAPERLESS_OCR_DPI=200
# PAPERLESS_OCR_PAGE_TIMEOUT=180       # per-page timeout (cloud)
# PAPERLESS_OLLAMA_OCR_PAGE_TIMEOUT=900  # per-page timeout (local Ollama / CPU)
# PAPERLESS_OCR_MAX_IMAGE_PX=1536      # downscale page images before vision OCR
# PAPERLESS_OLLAMA_OCR_MAX_IMAGE_PX=1024  # tighter cap for local Ollama on CPU
# PAPERLESS_OLLAMA_OCR_NUM_CTX=4096
# PAPERLESS_OLLAMA_OCR_NUM_PREDICT=4096
# PAPERLESS_OLLAMA_VISION_NUM_CTX=8192
# PAPERLESS_OLLAMA_VISION_NUM_PREDICT=8192
# PAPERLESS_EXTRACT_MAX_CHARS=48000    # OCR text budget for metadata extraction

# --- Updates ---
# PAPERLESS_UPDATE_REPO=dpastoetter/paperlessagent

# --- Internal (set by systemd unit; do not edit manually) ---
# PAPERLESS_SYSTEMD=1
